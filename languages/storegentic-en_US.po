msgstr "%1$s: the service failed to respond %2$s times. Last message: \"%3$s\"."

#: src/Admin/Riquadro.php:143
msgid "Tutto in ordine: il servizio risponde e il piano tiene."
msgstr "All good: the service responds and the plan has room left."

#: src/Admin/Riquadro.php:177
msgid "Questo mese non è ancora arrivata nessuna domanda."
msgstr "No questions yet this month."

