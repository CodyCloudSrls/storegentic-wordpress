msgid "Storegentic"
msgstr "Storegentic"

#. Plugin URI of the plugin
#: storegentic.php
msgid "https://storegentic.it"
msgstr "https://storegentic.it"

#. Description of the plugin
#: storegentic.php
msgid "Collega un sito WordPress a Storegentic: ricerca semantica, ricerca con una foto, assistente e analisi. Con WooCommerce indicizza i prodotti; senza, indicizza i contenuti del sito e fa da base di conoscenza. Funziona con qualsiasi tema, senza toccarlo."
msgstr "Conecta un sitio WordPress a Storegentic: búsqueda semántica, búsqueda por imagen, asistente y analíticas. Con WooCommerce indexa los productos; sin él, indexa los contenidos del sitio y sirve de base de conocimiento. Funciona con cualquier tema, sin tocarlo."

#. Author of the plugin
#: storegentic.php
msgid "CodyCloud Srls"
msgstr "CodyCloud Srls"

#. Author URI of the plugin
#: storegentic.php
msgid "https://www.codycloud.it"
msgstr "https://www.codycloud.it"

