msgid "Senza risultati"
msgstr "Ohne Ergebnisse"

#: src/Admin/Riquadro.php:186
#: src/Admin/viste/panoramica.php:158
msgid "Domande diverse"
msgstr "Eindeutige Fragen"

#: src/Admin/Riquadro.php:215
#: src/Admin/viste/panoramica.php:164
msgid "Cercato e non trovato"
msgstr "Gesucht und nicht gefunden"

#. translators: %s: quante volte.
#: src/Admin/Riquadro.php:226
