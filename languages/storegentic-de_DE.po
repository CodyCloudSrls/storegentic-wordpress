#: src/Admin/Pagina.php:108
msgid "Impostazioni"
msgstr "Einstellungen"

#: src/Admin/Pagina.php:118
msgid "Non hai i permessi per modificare queste impostazioni."
msgstr "Sie haben keine Berechtigung, diese Einstellungen zu ändern."

#. translators: %s: l'elenco degli accostamenti che non si leggono, con il loro rapporto.
#: src/Admin/Pagina.php:301
#, php-format
msgid "Colori salvati, ma questi accostamenti sono sotto il 4,5:1 richiesto e non si leggono bene: %s."
msgstr "Die Farben sind gespeichert. Diese Farbpaare liegen aber unter dem geforderten Wert 4,5:1 und sind schlecht lesbar: %s."

#: src/Admin/Pagina.php:327
msgid "Non hai i permessi per questa operazione."
msgstr "Sie haben keine Berechtigung für diesen Vorgang."

#: src/Admin/Pagina.php:437
msgid "Salva le impostazioni"
msgstr "Einstellungen speichern"

#: src/Admin/Riquadro.php:76
msgid "Tutte le statistiche"
msgstr "Gesamte Statistik"

#: src/Admin/Riquadro.php:83
msgid "Storegentic non è ancora collegato: manca la chiave del servizio."
msgstr "Storegentic ist noch nicht verbunden: Der Schlüssel für den Dienst fehlt."

#: src/Admin/Riquadro.php:85
msgid "Collega ora"
msgstr "Jetzt verbinden"

#. translators: %s: il nome del contatore finito.
#: src/Admin/Riquadro.php:104
#, php-format
msgid "Il piano ha finito: %s. Il servizio rifiuta le richieste."
msgstr "Der Tarif ist aufgebraucht: %s. Der Dienst lehnt Anfragen ab."

#. translators: 1: nome del contatore, 2: quanti ne restano.
#: src/Admin/Riquadro.php:113
#, php-format
msgid "Quasi finito: %1$s, ne restano %2$s."
msgstr "Fast aufgebraucht: %1$s, es bleiben noch %2$s."

#. translators: 1: nome della funzione, 2: quante volte, 3: il messaggio del servizio.
#: src/Admin/Riquadro.php:131
#, php-format
msgid "%1$s: il servizio non ha risposto %2$s volte. Ultimo messaggio: «%3$s»."
msgstr "%1$s: Der Dienst hat %2$s Mal nicht geantwortet. Letzte Meldung: „%3$s“."

#: src/Admin/Riquadro.php:143
msgid "Tutto in ordine: il servizio risponde e il piano tiene."
msgstr "Alles in Ordnung: Der Dienst antwortet und der Tarif reicht."

#: src/Admin/Riquadro.php:177
msgid "Questo mese non è ancora arrivata nessuna domanda."
msgstr "In diesem Monat gibt es noch keine Fragen."

#: src/Admin/Riquadro.php:184
#: src/Admin/viste/panoramica.php:146
