# What does NOT go into the repository.
#
# The compiled catalogues (.mo and .l10n.php) DO go in, on purpose: WordPress
# reads them, and a plugin from a repository without them installs in Italian
# in each language. They come from the .po files, but only if a person
# remembers to make them.

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# If a future version uses Composer or npm
/vendor/
/node_modules/

# The release packages come from bin/build-zip.sh
/dist/
/storegentic-*.zip
/storegentic-*.zip.sha256
